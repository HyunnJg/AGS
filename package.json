{
  "name": "ai-general-staff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.22.3 <25" },
  "scripts": {
    "dev": "node scripts/mock.ts",
    "server": "node apps/server/src/main.ts",
    "server:start": "node dist/apps/server/src/main.js",
    "lint": "biome lint apps scripts tests packages",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/scripts/mock.js",
    "test:built": "node --test tests/server-entry.test.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:built"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
